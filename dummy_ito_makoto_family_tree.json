    "workingCopies": [
      {
        "branchId": "group-overflow-main",
        "workId": "group-overflow",
        "text": "沢越家・伊藤家系譜\n\nOverflow作品群の壮絶な血縁グラフ。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-tomaru-main",
        "workId": "person-tomaru",
        "text": "沢越止\n\nすべての元凶。数多くの女性との間に子孫を残した始祖的存在。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-moeka-main",
        "workId": "person-moeka",
        "text": "伊能萌香\n\n止の娘であり、止のパートナーの一人。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-odoriko-main",
        "workId": "person-odoriko",
        "text": "西園寺踊子\n\n止の娘。世界の母。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-manami-main",
        "workId": "person-manami",
        "text": "桂真奈美\n\n止の娘。言葉と心の母。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-shun-main",
        "workId": "person-shun",
        "text": "間瞬\n\n止の息子。踊子との間に世界をもうける。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-chiho-main",
        "workId": "person-chiho",
        "text": "伊藤智歩\n\n止の娘。止との間に誠と止をもうける。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-makoto-main",
        "workId": "person-makoto",
        "text": "伊藤誠\n\n『School Days』主人公。沢越止と伊藤智歩の息子。止は父であり祖父。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-sekai-main",
        "workId": "person-sekai",
        "text": "西園寺世界\n\n『School Days』ヒロイン。間瞬と西園寺踊子の娘。誠とはいとこかつ叔父と姪。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-kotonoha-main",
        "workId": "person-kotonoha",
        "text": "桂言葉\n\n『School Days』メインヒロイン。桂真奈美の長女。誠とは異母姉妹の血を引く。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "branchId": "person-setsuna-main",
        "workId": "person-setsuna",
        "text": "清浦刹那\n\n世界の親友でいとこ（母の舞が踊子の妹）。誠に想いを寄せる。",
        "updatedAt": "2026-09-01T00:00:00.000Z"
      }
    ],
