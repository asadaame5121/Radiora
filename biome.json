{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["./biome.legacy.json"],
	"files": {
		"includes": [
			"src/**/*.{ts,tsx,js,jsx,svelte,css}",
			"scripts/**/*.{ts,tsx,js,jsx}",
			"tests/**/*.{ts,tsx,js,jsx}",
			"vitest/**/*.{ts,tsx,js,jsx}",
			"stories/**/*.{ts,tsx,js,jsx,svelte}",
			".storybook/**/*.{ts,tsx,js,jsx}",
			"deno.json",
			"biome.json",
			"biome.legacy.json",
			".jscpd.json",
			"stryker*.mjs",
			"vite.config.ts",
			"vitest*.config.ts",
			"playwright*.config.ts",
			"svelte.config.js",
			"knip.json",
			"tsconfig.json",
			"!output",
			"!!**/.delta"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"assist": {
		"enabled": false
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"plugins": [
		{
			"path": "./lint-plugins/noDangerousTypeAssertion.grit",
			"includes": [
				"**/*.{ts,tsx,js,jsx,svelte}",
				"!**/*_test.{ts,tsx,js,jsx}",
				"!**/*.test.{ts,tsx,js,jsx}",
				"!tests/**",
				"!vitest/**",
				"!stories/**",
				"!.storybook/**",
				"!**/fixtures/**"
			]
		},
		{
			"path": "./lint-plugins/noSwallowedRejection.grit",
			"includes": ["**/*.{ts,tsx,js,jsx,svelte}"]
		}
	],
	"linter": {
		"enabled": true,
		"includes": [
			"src/**/*.{ts,tsx,js,jsx,svelte,css}",
			"scripts/**/*.{ts,tsx,js,jsx}",
			"tests/**/*.{ts,tsx,js,jsx}",
			"vitest/**/*.{ts,tsx,js,jsx}",
			"stories/**/*.{ts,tsx,js,jsx,svelte}",
			".storybook/**/*.{ts,tsx,js,jsx}",
			"!output",
			"!!**/.delta"
		],
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 15 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": { "maxLines": 50, "skipBlankLines": true }
				},
				"useMaxParams": {
					"level": "error",
					"options": { "max": 6 }
				}
			},
			"nursery": {
				"noFloatingPromises": "error",
				"useReduceTypeParameter": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useAsConstAssertion": "error",
				"useErrorCause": "error"
			},
			"suspicious": {
				"noDoubleEquals": "error",
				"noEmptyBlockStatements": "error",
				"noExplicitAny": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*_test.{ts,tsx,js,jsx}",
				"**/*.test.{ts,tsx,js,jsx}",
				"tests/**",
				"vitest/**",
				"stories/**",
				".storybook/**"
			],
			"linter": {
				"rules": {
					"complexity": { "noExcessiveLinesPerFunction": "off" }
				}
			}
		}
	]
}
