{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["./biome.legacy.json"],
	"files": {
		"includes": [
			"src/**/*.{ts,tsx,js,jsx,svelte,css}",
			"scripts/**/*.{ts,tsx,js,jsx}",
			"tests/**/*.{ts,tsx,js,jsx}",
			"vitest/**/*.{ts,tsx,js,jsx}"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"plugins": [
		{
			"path": "./lint-plugins/noDangerousTypeAssertion.grit",
			"includes": [
				"**/*.{ts,tsx,js,jsx,svelte}",
				"!**/*_test.{ts,tsx,js,jsx}",
				"!**/*.test.{ts,tsx,js,jsx}",
				"!tests/**",
				"!vitest/**",
				"!**/fixtures/**"
			]
		},
		{
			"path": "./lint-plugins/noSwallowedRejection.grit",
			"includes": ["**/*.{ts,tsx,js,jsx,svelte}"]
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 15 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": { "maxLines": 50, "skipBlankLines": true }
				},
				"useMaxParams": {
					"level": "error",
					"options": { "max": 6 }
				}
			},
			"nursery": {
				"noFloatingPromises": "error",
				"useReduceTypeParameter": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useAsConstAssertion": "error",
				"useErrorCause": "error"
			},
			"suspicious": {
				"noDoubleEquals": "error",
				"noEmptyBlockStatements": "error",
				"noExplicitAny": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*_test.{ts,tsx,js,jsx}",
				"**/*.test.{ts,tsx,js,jsx}",
				"tests/**",
				"vitest/**"
			],
			"linter": {
				"rules": {
					"complexity": { "noExcessiveLinesPerFunction": "off" }
				}
			}
		}
	]
}
