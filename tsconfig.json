{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": ["src/domain/**/*.ts", "src/shared/**/*.ts", "src/ui/**/*.ts", "src/ui/**/*.svelte"]
}
