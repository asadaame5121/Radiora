{
	"name": "radiora-v2-poc",
	"private": true,
	"version": "0.4.3",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev:web": "vite",
		"dev:mock": "vite --mode mock",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test:svelte": "vitest run --project unit",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:storybook": "vitest run --project storybook",
		"test:storybook:coverage": "vitest run --project storybook --coverage",
		"test:a11y": "playwright test --config playwright.a11y.config.ts",
		"test:visual": "playwright test --config playwright.visual.config.ts",
		"test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
		"coverage:unit": "vitest run --project unit --coverage --coverage.reporter=json-summary --coverage.reporter=text",
		"test:mutation": "stryker run stryker.config.mjs",
		"test:mutation:parsers": "stryker run stryker.parsers.config.mjs",
		"test:mutation:projections": "stryker run stryker.projections.config.mjs",
		"test:mutation:domain": "stryker run stryker.domain.config.mjs",
		"test:mutation:storage": "stryker run stryker.storage.config.mjs",
		"test:mutation:controllers": "stryker run stryker.config.mjs"
	},
	"dependencies": {
		"@tursodatabase/database": "0.7.2",
		"@tursodatabase/sync": "0.7.2",
		"bits-ui": "2.18.1",
		"d3": "^7.9.0",
		"overtype": "2.4.0",
		"surrealdb": "^2.0.8",
		"svelte": "^5.56.8"
	},
	"overrides": {
		"qs": "6.15.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "2.5.2",
		"@playwright/test": "1.58.2",
		"@storybook/addon-a11y": "10.5.7",
		"@storybook/addon-docs": "10.5.7",
		"@storybook/addon-vitest": "10.5.7",
		"@storybook/svelte-vite": "10.5.7",
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/vitest-runner": "9.6.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/d3": "^7.4.3",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"commonmark": "0.31.2",
		"jscpd": "5.0.12",
		"playwright": "1.58.2",
		"storybook": "10.5.7",
		"svelte-check": "^4.7.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.10"
	}
}
