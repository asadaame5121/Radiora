    "revisions": [
      {
        "id": "group-isono-rev-1",
        "workId": "group-isono",
        "text": "磯野家\n\n世田谷区桜新町在住の磯野家一族。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-namihei-rev-1",
        "workId": "person-namihei",
        "text": "磯野波平\n\n磯野家の大黒柱。山高商事の課長。頑固だが情に厚い。フネの夫。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-fune-rev-1",
        "workId": "person-fune",
        "text": "磯野フネ\n\n波平の妻。物静かで家族を温かく見守る良妻賢母。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-umihei-rev-1",
        "workId": "person-umihei",
        "text": "磯野海平\n\n波平の双子の兄。福岡在住。波平との見分け方は頭頂部の髪の毛（2本）。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-katsuo-rev-1",
        "workId": "person-katsuo",
        "text": "磯野カツオ\n\n磯野家の長男。小学5年3組。いたずら好きでお調子者だが機転が利く。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-wakame-rev-1",
        "workId": "person-wakame",
        "text": "磯野ワカメ\n\n磯野家の次女。小学3年1組。真面目で心優しい少女。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "group-fuguta-rev-1",
        "workId": "group-fuguta",
        "text": "フグ田家\n\n磯野家に同居するサザエ・マスオ・タラオの一家。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-sazae-rev-1",
        "workId": "person-sazae",
        "text": "フグ田サザエ\n\n本作の主人公。波平とフネの長女。マスオの妻、タラオの母。明るく行動的。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-masuo-rev-1",
        "workId": "person-masuo",
        "text": "フグ田マスオ\n\nサザエの夫。海山商事勤務。誠実で優しく、義理の実家でも円満に暮らす。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-tarao-rev-1",
        "workId": "person-tarao",
        "text": "フグ田タラオ\n\nサザエとマスオの長男。3歳。好奇心旺盛で礼儀正しい。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "group-namino-rev-1",
        "workId": "group-namino",
        "text": "波野家\n\n波平の甥であるノリスケの一家。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-norisuke-rev-1",
        "workId": "person-norisuke",
        "text": "波野ノリスケ\n\n波平・海平の妹なぎえの息子（甥）。出版社勤務。明るく図々しい愛されキャラ。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-taiko-rev-1",
        "workId": "person-taiko",
        "text": "波野タイコ\n\nノリスケの妻。上品でしっかり者。サザエとも仲が良い。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      },
      {
        "id": "person-ikura-rev-1",
        "workId": "person-ikura",
        "text": "波野イクラ\n\nノリスケとタイコの長男。タラオのいとこ甥（はとこ）。「ハーイ」「チャーン」「バブー」。",
        "parentRevisionIds": [],
        "kind": "edition",
        "createdAt": "2026-09-01T00:00:00.000Z"
      }
    ],
